// ============================================================
// LATINIUM ROGUELIKE - MINI
// A compact turn-based dungeon crawler for OpenLatinum
//
// Quomodo ludere:
//   lat run roguelike.lat
//   Imperia: n=septentrio, s=meridies, e=oriens, w=occidens, q=desinere
// ============================================================

// ---------- CONSTANTS ----------
MAP_W: integer = 12
MAP_H: integer = 8
MAP_SIZE: integer = 96

TILE_FLOOR: integer = 0
TILE_WALL: integer = 1
TILE_PLAYER: integer = 2
TILE_GOBLIN: integer = 3
TILE_POTION: integer = 4
TILE_STAIRS: integer = 5

// ---------- GLOBAL STATE ----------
map: vec<integer>[96]

// Player
px: integer
py: integer
php: integer
pxp: integer

// Monsters (max 3)
mx: vec<integer>[3]
my: vec<integer>[3]
mhp: vec<integer>[3]
malive: vec<integer>[3]
mcount: integer

// Items (max 3)
ix: vec<integer>[3]
iy: vec<integer>[3]
ialive: vec<integer>[3]
icount: integer

// Game state
gturn: integer
gover: integer
gwon: integer
empty_count: integer = 0
in_combat: integer = 0

// Random
rseed: integer = 12345

// ---------- RANDOM ----------
munus rand() -> integer {
    rseed = (rseed * 1103515245 + 12345) % 2147483648
    si rseed < 0 { rseed = rseed + 2147483648 }
    reditus rseed
}

munus rrange(lo: integer, hi: integer) -> integer {
    reditus lo + (rand() % (hi - lo + 1))
}

// ---------- MAP ----------
munus midx(x: integer, y: integer) -> integer {
    reditus y * MAP_W + x
}

munus init_map() {
    i: integer
    enim(i = 0; i < MAP_SIZE; i = i + 1) {
        map[i] = TILE_WALL
    }
}

munus carve(rx: integer, ry: integer, rw: integer, rh: integer) {
    y: integer
    x: integer
    enim(y = ry; y < ry + rh; y = y + 1) {
        enim(x = rx; x < rx + rw; x = x + 1) {
            si x > 0 et x < MAP_W - 1 et y > 0 et y < MAP_H - 1 {
                map[midx(x, y)] = TILE_FLOOR
            }
        }
    }
}

munus hcorr(x1: integer, x2: integer, y: integer) {
    i: integer
    si x1 < x2 {
        enim(i = x1; i <= x2; i = i + 1) {
            map[midx(i, y)] = TILE_FLOOR
        }
    } aliter {
        enim(i = x2; i <= x1; i = i + 1) {
            map[midx(i, y)] = TILE_FLOOR
        }
    }
}

munus vcorr(y1: integer, y2: integer, x: integer) {
    i: integer
    si y1 < y2 {
        enim(i = y1; i <= y2; i = i + 1) {
            map[midx(x, i)] = TILE_FLOOR
        }
    } aliter {
        enim(i = y2; i <= y1; i = i + 1) {
            map[midx(x, i)] = TILE_FLOOR
        }
    }
}

// ---------- RENDER ----------
munus tchar(t: integer) -> filum {
    si t == TILE_WALL { reditus "#" }
    si t == TILE_FLOOR { reditus "." }
    si t == TILE_PLAYER { reditus "@" }
    si t == TILE_GOBLIN { reditus "g" }
    si t == TILE_POTION { reditus "!" }
    si t == TILE_STAIRS { reditus ">" }
    reditus "?"
}

munus clear() {
    // Print separator between frames
    print("\n========================================\n\n")
}

munus draw_hp_bar() {
    i: integer
    print("[")
    enim(i = 0; i < 10; i = i + 1) {
        si i < php {
            print("#")
        } aliter {
            print("-")
        }
    }
    print("]")
}

munus show_intro() {
    print("\n")
    print("+========================================================+\n")
    print("|                                                        |\n")
    print("|           LATINIUM ROGUELIKE                           |\n")
    print("|                                                        |\n")
    print("+========================================================+\n")
    print("\n")
    print("Fabula:\n")
    print("Tu es explorator audax. In antro obscuro sub terra\n")
    print("dormivisti. Nunc evigilas! Goblini te circumdant.\n")
    print("Scala una ad libertatem ducit. Inveni eam!\n")
    print("\n")
    print("Consilia:\n")
    print("- Move per antrum (n/s/e/w vel h/j/k/l)\n")
    print("- Vita goblinos (g) - te oppugnant!\n")
    print("- Collige pocula (!) - te sanant (+5 PV)\n")
    print("- Inveni scalas (>) - ad victoriam ducunt\n")
    print("- Si puncta vitae (PV) ad 0 cadunt, morieris\n")
    print("\n")
    print("Signa:\n")
    print("  @ = tu (ludator)        g = goblinus (hostis)\n")
    print("  ! = poculum (sanatio)   > = scalae (victoria)\n")
    print("  . = solum               # = paries\n")
    print("\n")
    print("Pressa 'q' ad desinendum.\n")
    print("\n")
    print("Pressa Enter ad incipiendum...")
    discard: filum = legeres()
    print("\n")
}

munus draw() {
    clear()
    
    // Title
    print("=== LATINIUM ROGUELIKE ===\n")
    print("Inveni scalas (>). Vita goblinos (g).\n")
    print("Pocula (!) te sanant.\n\n")
    
    // Map border
    print("+------------+\n")
    
    // Map rows
    y: integer
    x: integer
    enim(y = 0; y < MAP_H; y = y + 1) {
        row: filum = "|"
        enim(x = 0; x < MAP_W; x = x + 1) {
            t: integer
            t = map[midx(x, y)]
            si x == px et y == py {
                row = row + "@"
            } aliter {
                row = row + tchar(t)
            }
        }
        row = row + "|"
        print(row + "\n")
    }
    print("+------------+\n\n")
    
    // Stats
    print("PV: ")
    print(php)
    print(" / 10  |  XP: ")
    print(pxp)
    print("  |  Versus: ")
    print(gturn)
    print("\n")
    
    // HP Bar
    draw_hp_bar()
    print("\n\n")
    
    // Legend
    print("Signa:  @=ludator  g=goblin  !=poculum  >=scalae\n")
    print("        .=solum    #=paries\n\n")
    
    // Controls
    print("Imperia: n=septentrio  s=meridies  e=oriens  w=occidens\n")
    print("         k=supra      j=infra     l=dextra  h=sinistra\n")
    print("         q=desinere\n\n")
    print("> ")
}

// ---------- ENTITIES ----------
munus spawn_monsters() {
    i: integer
    mcount = 0
    enim(i = 0; i < 3; i = i + 1) {
        x: integer = rrange(2, MAP_W - 3)
        y: integer = rrange(2, MAP_H - 3)
        si map[midx(x, y)] == TILE_FLOOR {
            mx[i] = x
            my[i] = y
            mhp[i] = 2
            malive[i] = 1
            mcount = mcount + 1
        }
    }
}

munus spawn_items() {
    i: integer
    icount = 0
    enim(i = 0; i < 3; i = i + 1) {
        x: integer = rrange(2, MAP_W - 3)
        y: integer = rrange(2, MAP_H - 3)
        si map[midx(x, y)] == TILE_FLOOR {
            ix[i] = x
            iy[i] = y
            ialive[i] = 1
            icount = icount + 1
        }
    }
}

munus place_stairs() {
    x: integer = rrange(2, MAP_W - 3)
    y: integer = rrange(2, MAP_H - 3)
    si map[midx(x, y)] == TILE_FLOOR {
        map[midx(x, y)] = TILE_STAIRS
    }
}

// ---------- MOVEMENT ----------
munus is_walkable(x: integer, y: integer) -> integer {
    si x < 0 aut x >= MAP_W aut y < 0 aut y >= MAP_H {
        reditus 0
    }
    si map[midx(x, y)] == TILE_WALL {
        reditus 0
    }
    reditus 1
}

munus move_player(dx: integer, dy: integer) {
    nx: integer = px + dx
    ny: integer = py + dy
    si is_walkable(nx, ny) == 0 {
        reditus
    }
    px = nx
    py = ny

    // Check stairs
    si map[midx(px, py)] == TILE_STAIRS {
        print("Scala invenisti! Vicisti!\n")
        gturn = gturn + 1
        gwon = 1
        gover = 1
        reditus
    }

    // Check items
    i: integer
    enim(i = 0; i < 3; i = i + 1) {
        si ialive[i] == 1 et ix[i] == px et iy[i] == py {
            php = php + 5
            ialive[i] = 0
            print("Poculum! PV +5\n")
        }
    }

    // Check monsters - interactive combat
    enim(i = 0; i < 3; i = i + 1) {
        si malive[i] == 1 et mx[i] == px et my[i] == py {
            combat_monster(i)
        }
    }

    gturn = gturn + 1
}

// ---------- COMBAT ----------
munus combat_monster(idx: integer) {
    old_px: integer = px
    old_py: integer = py
    in_combat = 1
    
    print("\n+----------------------------------------+")
    print("\n|           PUGNA!                       |")
    print("\n+----------------------------------------+")
    print("\nGoblinus appropinquat! PV: ")
    print(mhp[idx])
    print("\n")
    
    dum malive[idx] == 1 et php > 0 {
        print("\nTuus PV: ")
        print(php)
        print(" | Goblinus PV: ")
        print(mhp[idx])
        print("\n")
        print("Quid facis? (a=oppugnare, f=fugere)\n")
        print("> ")
        
        action: filum = legeres()
        si action == "a" {
            // Player attacks
            hit: integer = rrange(1, 100)
            si hit <= 80 {
                dmg: integer = rrange(1, 3)
                mhp[idx] = mhp[idx] - dmg
                print("Percussisti goblinum! Dammum: ")
                print(dmg)
                print("\n")
                si mhp[idx] <= 0 {
                    malive[idx] = 0
                    pxp = pxp + 10
                    print("Goblinus mortuus est! XP +10\n")
                }
            } aliter {
                print("Oppugnationem vitavit goblinus!\n")
            }
            
            // Monster counter-attack if alive
            si malive[idx] == 1 {
                mhit: integer = rrange(1, 100)
                si mhit <= 70 {
                    mdmg: integer = rrange(1, 2)
                    php = php - mdmg
                    print("Goblinus te percussit! Dammum: ")
                    print(mdmg)
                    print("\n")
                    si php <= 0 {
                        print("\nMortuus es!\n")
                        gover = 1
                        reditus
                    }
                } aliter {
                    print("Goblinum repulisti!\n")
                }
            }
        } aliter {
            si action == "f" {
                flee_chance: integer = rrange(1, 100)
                si flee_chance <= 60 {
                    px = old_px
                    py = old_py
                    print("Fugisti!\n")
                    reditus
                } aliter {
                    print("Fugere non potes!\n")
                    // Monster free attack
                    mhit: integer = rrange(1, 100)
                    si mhit <= 70 {
                        mdmg: integer = rrange(1, 2)
                        php = php - mdmg
                        print("Goblinus te percussit! Dammum: ")
                        print(mdmg)
                        print("\n")
                        si php <= 0 {
                            print("\nMortuus es!\n")
                            gover = 1
                            reditus
                        }
                    } aliter {
                        print("Goblinum repulisti!\n")
                    }
                }
            } aliter {
                print("Imperium ignotum. Utere 'a' aut 'f'.\n")
            }
        }
    }
    in_combat = 0
}

munus move_monsters() {
    i: integer
    enim(i = 0; i < 3; i = i + 1) {
        si malive[i] == 1 {
            dx: integer = 0
        dy: integer = 0
        si mx[i] < px { dx = 1 }
        si mx[i] > px { dx = -1 }
        si my[i] < py { dy = 1 }
        si my[i] > py { dy = -1 }

        nx: integer = mx[i] + dx
        ny: integer = my[i] + dy
        si is_walkable(nx, ny) == 1 {
            mx[i] = nx
            my[i] = ny
        }

        si mx[i] == px et my[i] == py {
            print("Monstrum oppugnat!\n")
            php = php - 1
            si php <= 0 {
                print("Mortuus es!\n")
                gover = 1
            }
        }
        }
    }
}

// ---------- GAME LOOP ----------
munus process_input() -> integer {
    cmd: filum = legeres()
    si cmd == "" {
        // Enter key just redraws - never quits
        reditus 0
    }
    si cmd == "n" aut cmd == "k" {
        move_player(0, -1)
        reditus 2
    }
    si cmd == "s" aut cmd == "j" {
        move_player(0, 1)
        reditus 2
    }
    si cmd == "e" aut cmd == "l" {
        move_player(1, 0)
        reditus 2
    }
    si cmd == "w" aut cmd == "h" {
        move_player(-1, 0)
        reditus 2
    }
    si cmd == "q" {
        print("Vale!\n")
        reditus 1
    }
    print("Imperium ignotum. Utere n/s/e/w, h/j/k/l, aut q.\n")
    reditus 0
}

// ---------- MAIN ----------
munus main() {
    init_map()

    // 3 rooms
    carve(2, 2, 4, 3)
    carve(8, 2, 3, 3)
    carve(5, 5, 4, 2)

    // Corridors
    hcorr(5, 8, 3)
    vcorr(4, 5, 6)

    // Player start
    px = 3
    py = 3
    php = 10
    pxp = 0

    spawn_monsters()
    spawn_items()
    place_stairs()

    gturn = 0
    gover = 0
    gwon = 0

    show_intro()

    dum gover == 0 {
        draw()
        action: integer = process_input()
        si action == 1 {
            confractus
        }
        si action == 2 et gover == 0 et in_combat == 0 {
            move_monsters()
        }
    }

    si gwon == 1 {
        print("\n")
        print("+----------------------------------------+\n")
        print("|        VICTORIA!                       |\n")
        print("|        Versus: ")
        print(gturn)
        print("\n")
        print("+----------------------------------------+\n")
    }
}
